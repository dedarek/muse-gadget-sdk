# Bind loopback first. To use the StickS3 on Wi-Fi, bind the Mac's LAN IP.
HOST=127.0.0.1
PORT=8787
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
GATEWAY_TOKEN=
# openai-compatible: Qwen, GPT, Gemini compatibility endpoint, local vLLM.
# anthropic: Claude native Messages API.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# For newer GPT models that reject max_tokens, use max_completion_tokens.
MODEL_TOKEN_FIELD=max_tokens
MODEL_MAX_TOKENS=160
MODEL_TEMPERATURE=
MODEL_TOP_P=
# Qwen/vLLM template flag, leave empty for unrelated providers.
# Low-latency voice on the tested Lenovo Qwen endpoint: false.
MODEL_ENABLE_THINKING=
# Optional speech services with OpenAI-compatible endpoints.
ASR_PROVIDER=openai-compatible
TTS_PROVIDER=openai-compatible
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
# Raw PCM rate returned by TTS. The device always receives 16 kHz mono PCM.
TTS_SAMPLE_RATE=24000
# Or use local speech without a second cloud API key (Mac Gateway only).
# ASR_PROVIDER=whisper-cpp
# WHISPER_MODEL_PATH=/absolute/path/to/ggml-small.bin
WHISPER_CLI=whisper-cli
ASR_LANGUAGE=zh
# TTS_PROVIDER=macos-say
MACOS_SAY_VOICE=Tingting
# Optional private scratch directory. Temporary audio is removed after each job.
SPEECH_TMP_DIR=
