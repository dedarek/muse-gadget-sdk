# Bind loopback first. To use the StickS3 on Wi-Fi, bind the Mac's LAN IP.
HOST=127.0.0.1
PORT=8787
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
GATEWAY_TOKEN=
# openai-compatible: Qwen, GPT, Gemini compatibility endpoint, local vLLM.
# anthropic: Claude native Messages API.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# For newer GPT models that reject max_tokens, use max_completion_tokens.
MODEL_TOKEN_FIELD=max_tokens
# Optional speech services with OpenAI-compatible endpoints.
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
# Raw PCM rate returned by TTS. The device always receives 16 kHz mono PCM.
TTS_SAMPLE_RATE=24000
